# Local-only overrides for this machine.
# Copy to .env.local when you need values that should override .env locally.
# Never commit the real .env.local file.

# Django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.development

# Optional initial owner bootstrap local overrides
EDUPLAIN_BOOTSTRAP_ADMIN_USERNAME=eduplain_su_owner
EDUPLAIN_BOOTSTRAP_ADMIN_EMAIL=owner@eduplain.local
EDUPLAIN_BOOTSTRAP_ADMIN_FULL_NAME=Eduplain System Owner
EDUPLAIN_BOOTSTRAP_ADMIN_ROLE=administrator
EDUPLAIN_BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL for Django running from the host
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Local PDF catalog and files
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=media/documents
NOSQL_DATABASE_CONNECTION=
