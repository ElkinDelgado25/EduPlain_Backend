# Django
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.development

# Optional initial owner bootstrap (leave empty to skip)
EDUPLAIN_BOOTSTRAP_ADMIN_USERNAME=eduplain_su_owner
EDUPLAIN_BOOTSTRAP_ADMIN_EMAIL=owner@eduplain.local
EDUPLAIN_BOOTSTRAP_ADMIN_FULL_NAME=Eduplain System Owner
EDUPLAIN_BOOTSTRAP_ADMIN_ROLE=administrator
EDUPLAIN_BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_DB=academic_db
POSTGRES_USER=academic_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Frontend local (Vite default port)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Aspire local orchestration (optional; avoids colliding with Docker Compose defaults)
ASPIRE_DJANGO_PORT=8000
ASPIRE_POSTGRES_PORT=55433

# Document storage
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=media/documents
NOSQL_DATABASE_CONNECTION=
